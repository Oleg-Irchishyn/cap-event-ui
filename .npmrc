# Scope -> GitHub Packages registry
@oleg-irchishyn:registry=https://npm.pkg.github.com

# Auth token is read from the NODE_AUTH_TOKEN env var (never commit a real token).
# Local:  GitHub PAT (classic) with read:packages
# CI:     GitHub Actions provides it via secrets.GITHUB_TOKEN
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
