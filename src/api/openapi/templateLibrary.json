    "/template/metadata": {
      "get": {
        "tags": ["Template"],
        "summary": "Get template metadata",
        "description": "This endpoint retrieves a template metadata based on sponsor ID, fund group ID and entity ID.",
        "operationId": "getTemplateMetadata",
        "parameters": [
          {
            "name": "sponsorId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID of the sponsor"
          },
          {
            "name": "fundGroupId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ID of the fund group id"
          },
          {
            "name": "entityId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ID of the entity"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved template metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateMetadata"
                },
                "example": {
                  "id": 101,
                  "box_id": "template-box-001",
                  "name": "Standard Distribution Template"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid or missing parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "BAD_REQUEST",
                  "message": "Missing required parameter: sponsorId or eventTypeId",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-12345-abc"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "UNAUTHORIZED",
                  "message": "Authentication credentials were not provided or are invalid",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-auth-001"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "FORBIDDEN",
                  "message": "User does not have permission to access templates for this sponsor",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-auth-002"
                }
              }
            }
          },
          "404": {
            "description": "No templates found for the specified criteria",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "NOT_FOUND",
                  "message": "No templates found for the given sponsorId and eventTypeId",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-67890-def"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity - validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "VALIDATION_ERROR",
                  "message": "Invalid parameter values provided",
                  "details": [
                    {
                      "field": "eventTypeId",
                      "reason": "INVALID_VALUE",
                      "message": "eventTypeId must be a positive integer"
                    }
                  ],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-validation-001"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "INTERNAL_SERVER_ERROR",
                  "message": "Error retrieving template metadata from database",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-54321-ghi"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TemplateMetadata": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique id for the template in UUID format"
          },
          "box_id": {
            "type": "string",
            "description": "Internal Box id of template in UUID format"
          },
          "name": {
            "type": "string",
            "description": "Name of the template"
          }
        },
        "required": [
          "id",
          "box_id",
          "name"
        ]
      },
      "CeBoxItemInfo": {
        "type":"object",
        "description": "The general information about box item.",
        "properties": {
          "name": {
            "description": "The name of the file.",
            "type": "string"
          },
          "parentFolderId": {
            "description": "The id of the parent item to access in the box service.",
            "type": "string"
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp of the last item modification."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp of item creation."
          },
          "size": {
            "type": "long",
            "description": "The required disk space to store the file"
          }
        }
      },
      "CeBoxItem": {
        "type": "object",
        "description": "The common information about box item.",
        "properties": {
          "id": {
            "description": "The id of the item to access in the box service.",
            "type": "string"
          },
          "info": {
            "$ref": "#/components/schemas/CeBoxItemInfo"
          }
        }
      },
      "CeBoxFile": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/CeBoxItem"
          },
          {
            "type":"object",
            "description": "The content of the file int the box.",
            "properties": {
              "content": {
                "type" : "string",
                "format": "binary"
              }
            }
          }
        ]
      },
      "NamedObject": {
        "type": "object",
        "description": "The common structure of the object with name and id.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique id of the object in the system."
          },
          "name": {
            "type": "string",
            "description": "The name of the object in the system."
          }
        }
      },
      "Sponsor": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NamedObject"
          }
        ]
      },
      "FundGroup": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NamedObject"
          }
        ]
      },
      "Entity": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NamedObject"
          }
        ]
      },
      "Template": {
        "type": "object",
        "description": "The information about template in the system.",
        "properties": {
          "id":{
            "type": "string",
            "description": "The id of the template registered in the library in UUID format."
          },
          "boxFile": {
            "$ref": "#/components/schemas/CeBoxFile"
          },
          "description": {
            "type": "string",
            "description": "The user description of the template."
          },
          "sourceTemplate": {
            "$ref": "#/components/schemas/Template"
          },
          "sponsor": {
            "$ref": "#/components/schemas/Sponsor"
          },
          "fundGroup": {
            "$ref": "#/components/schemas/FundGroup"
          },
          "entity": {
            "$ref": "#/components/schemas/Entity"
          },
          "createdBy": {
            "type": "string",
            "description": "The name or id of the user who created a template."
          },
          "modifiedBy": {
            "type": "string",
            "description": "The name or id of the user who make the last changes in a template."
          },
          "status": {
            "type": "string",
            "enum": ["Active", "Inactive"],
            "description": "The status of the template."
          }
        },
        "required": ["id"]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Object that represents errors details",
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["VALIDATION_ERROR", "NOT_FOUND", "INTERNAL_SERVER_ERROR", "UNAUTHORIZED", "FORBIDDEN", "BAD_REQUEST", "CONFLICT"],
            "description": "Error reason code"
          },
          "message": {
            "type": "string",
            "description": "Error message describing what went wrong"
          },
          "details": {
            "type": "array",
            "items": {
              "title": "ErrorDetail",
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            },
            "description": "Array of error details"
          },
          "timestamp": {
            "type": "string",
            "description": "Error timestamp"
          },
          "requestId": {
            "type": "string",
            "description": "Request id"
          }
        },
        "required": ["reason", "message", "details", "timestamp", "requestId"]
      }
    }
  }
}
