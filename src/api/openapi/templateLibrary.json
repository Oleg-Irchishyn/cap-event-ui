{
  "openapi": "3.0.3",
  "info": {
    "title": "Template Library API",
    "description": "API for Template Library. This library provides access to operations related to templates.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Template",
      "description": "Templates related operations"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:8080/api/v1",
      "description": "v1 API base path"
    }
  ],
  "paths": {
    "/templates": {
      "get": {
        "tags": ["Template"],
        "summary": "Get list of the available and allowed templates.",
        "description": "This endpoint retrieves a list of the available and allowed templates.",
        "operationId": "getTemplates",
        "parameters": [
          {
            "name": "Session-Id",
            "in": "header",
            "description": "Session identifier used to resolve Sponsor ID in case of it's absence",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved list of the templates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Template"
                  }
                },
                "example": [
                  {
                    "id": "1d577e4d-7590-4559-8151-e38d2143c1d1",
                    "boxFile": {
                      "id": "349216691219",
                      "info": {
                        "name": "Standard Template.dotx",
                        "parentForlderId": "349216691219",
                        "modifiedAt": "2025-11-06T12:57:04.204Z",
                        "createdAt": "2025-11-06T12:57:04.204Z",
                        "size": 14
                      },
                      "content": "contentcontent"
                    },
                    "sourceTemplate": {
                      "id": "f93c2a53-6ff3-4fd3-adaf-7f2abfef06b1"
                    },
                    "sponsor": {
                      "id": "sponsor-123",
                      "name": "The Best Sponsor"
                    },
                    "entityGroup": {
                      "id": "entity-group-222",
                      "name": "Charities"
                    },
                    "entity": {
                      "id": "entity-321",
                      "name": "Charity"
                    },
                    "createdBy": "user.email@gen2fund.com",
                    "modifiedBy": "user.email@gen2fund.com",
                    "status": "Active"
                  },
                  {
                    "id": "f93c2a53-6ff3-4fd3-adaf-7f2abfef06b1",
                    "boxFile": {
                      "documentId": "2036227281530",
                      "name": "System Base Template"
                    },
                    "sponsor": null,
                    "entityGroup": null,
                    "entity": null,
                    "createdBy": "system",
                    "modifiedBy": "user.email@gen2fund.com",
                    "status": "Active"
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Unauthorized - authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "UNAUTHORIZED",
                  "message": "Authentication credentials were not provided or are invalid",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-auth-001"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "FORBIDDEN",
                  "message": "User does not have permission to access to get templates",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-auth-002"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "INTERNAL_SERVER_ERROR",
                  "message": "Error retrieving template metadata from database",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-54321-ghi"
                }
              }
            }
          }

        }
      },
      "post": {
        "tags": ["Template"],
        "summary": "Create new template",
        "description": "This endpoint creates a new template for selected assignment level",
        "operationId": "createTemplate",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "sponsorId": {
                    "type": "string",
                    "description": "ID of the sponsor (required)"
                  },
                  "sponsorName": {
                    "type": "string",
                    "description": "Name of the sponsor (required)"
                  },
                  "fundGroupId": {
                    "type": "string",
                    "description": "ID of the fund group (optional)"
                  },
                  "entityId": {
                    "type": "string",
                    "description": "ID of the entity (optional)"
                  },
                  "newTemplate": {
                    "type": "string",
                    "format": "binary",
                    "description": "Template file to upload"
                  }
                },
                "required": ["sponsorId", "sponsorName", "newTemplate"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Template created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Template"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid or missing parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - file already exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity - validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/templates/{templateId}": {
      "put": {
        "tags": ["Template"],
        "summary": "Upload a new version of the template.",
        "description": "Upload a new version of the template. Even if template is identical it will create a new template version.",
        "operationId": "updateTemplate",
        "parameters": [
          {
            "name": "templateId",
            "in": "path",
            "schema": {
              "type":"string"
            },
            "required": true,
            "description": "ID of the template whichi should be updated."
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns information about the successfully uploaded template.",
            "content": {}
          },
          "401": {
            "description": "Unauthorized - authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "UNAUTHORIZED",
                  "message": "Authentication credentials were not provided or are invalid",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-auth-001"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "FORBIDDEN",
                  "message": "User does not have permission to access to get templates",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-auth-002"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "INTERNAL_SERVER_ERROR",
                  "message": "Error uploading the new template",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-54321-ghi"
                }
              }
            }
          }
        }
      }
    },
    "/templates/content": {
      "get": {
        "tags": ["Template"],
        "summary": "Returns template by sponsor, group, and entity IDs.",
        "description": "Returns ZIP archive with the template and the CSV file with available datapoints. Searches for a template matching the provided IDs, or falls back to a default template if not found.",
        "operationId": "getTemplateContentByParameters",
        "parameters" : [
          {
            "name": "sponsorId",
            "in": "query",
            "schema": {
              "type":"string"
            },
            "required": true,
            "description": "ID of the sponsor."
          },
          {
            "name": "fundGroupId",
            "in": "query",
            "schema": {
              "type":"string"
            },
            "required": false,
            "description": "ID of the fund group."
          },
          {
            "name": "entityId",
            "in": "query",
            "schema": {
              "type":"string"
            },
            "required": false,
            "description": "ID of the entity."
          }
        ],
        "responses": {
          "200": {
            "description": "ZIP file with the MS Word template and the CSV file with available datapoints.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "UNAUTHORIZED",
                  "message": "Authentication credentials were not provided or are invalid",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-auth-001"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "FORBIDDEN",
                  "message": "User does not have permission to access to get templates",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-auth-002"
                }
              }
            }
          },
          "404": {
            "description": "Template not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "NOT_FOUND",
                  "message": "No template found for the provided parameters and no default template available",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-notfound-001"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "INTERNAL_SERVER_ERROR",
                  "message": "Error retrieving template and dependend data.",
                  "details": [],
                  "timestamp": "2025-08-26T10:56:00Z",
                  "requestId": "req-54321-ghi"
                }
              }
            }
          }
        }
      }
    },
