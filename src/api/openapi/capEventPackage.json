{
  "openapi": "3.0.0",
  "info": {
    "title": "Cap Event Package API",
    "version": "v1",
    "description": "API for retrieving capital event types"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "v1 API base path"
    }
  ],
  "paths": {
    "/cap-events/types": {
      "get": {
        "summary": "Retrieve list of capital event types",
        "operationId": "getCapEventTypes",
        "responses": {
          "200": {
            "description": "List of capital event types",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CapEventType" }
                },
                "examples": {
                  "example": {
                    "value": [
                      {
                        "id": "657475ed-b745-41d3-a864-463847900129",
                        "abbreviation": "Call",
                        "name": "Capital Call"
                      },
                      {
                        "id": "657475ed-b745-41d3-a864-463847900123",
                        "abbreviation": "Distr",
                        "name": "Distribution"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "VALIDATION_ERROR",
                  "message": "Validation failed for argument",
                  "details": {
                    "field": "folderId",
                    "reason": "INVALID_VALUE",
                    "message": "size must be between 1 and 2147483647"
                  },
                  "timestamp": "2025-08-20T11:13:13.012739700Z",
                  "requestId": "9b173b09-785n-6458-k127-7e8a9j5644a"
                }
              }
            }
          },
          "404": {
            "description": "No event types found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "RESOURCE_NOT_FOUND",
                  "message": "Resource not found",
                  "details": "null",
                  "timestamp": "2025-08-20T11:13:13.012739700Z",
                  "requestId": "9b173b09-785n-6458-k127-7e8a9j5644a"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "INTERNAL_SERVER_ERROR",
                  "message": "Internal Server Error",
                  "details": "null",
                  "timestamp": "2025-08-20T11:13:13.012739700Z",
                  "requestId": "9b173b09-785n-6458-k127-7e8a9j5644a"
                }
              }
            }
          }
        }
      }
    },
    "/investments": {
      "get": {
        "summary": "Retrieve list of investments",
        "operationId": "getInvestments",
        "responses": {
          "200": {
            "description": "List of investments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Investment" }
                },
                "examples": {
                  "example": {
                    "value": [
                      {
                        "id": "inv-12345-abcd-6789-ef01-234567890123",
                        "name": "Real Estate Fund A",
                        "title": "Premium Real Estate Investment Fund",
                        "type": "real_estate"
                      },
                      {
                        "id": "inv-98765-dcba-4321-ef01-876543210987",
                        "name": "Tech Growth Fund",
                        "title": "Technology Growth Investment Fund",
                        "type": "equity"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "VALIDATION_ERROR",
                  "message": "Validation failed for argument",
                  "details": {
                    "field": "folderId",
                    "reason": "INVALID_VALUE",
                    "message": "size must be between 1 and 2147483647"
                  },
                  "timestamp": "2025-08-20T11:13:13.012739700Z",
                  "requestId": "9b173b09-785n-6458-k127-7e8a9j5644a"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "INTERNAL_SERVER_ERROR",
                  "message": "Internal Server Error",
                  "details": "null",
                  "timestamp": "2025-08-20T11:13:13.012739700Z",
                  "requestId": "9b173b09-785n-6458-k127-7e8a9j5644a"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CapEventType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "abbreviation": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Investment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the investment"
          },
          "name": {
            "type": "string",
            "description": "Short name of the investment"
          },
          "title": {
            "type": "string",
            "description": "Full descriptive title of the investment"
          },
          "type": {
            "type": "string",
            "description": "Type of the investment"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Error response with message",
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["VALIDATION_ERROR", "RESOURCE_NOT_FOUND", "INTERNAL_SERVER_ERROR"]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "title": "ErrorDetail",
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "timestamp": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
