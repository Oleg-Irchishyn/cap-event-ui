                  "requestId": "9b173b09-785n-6458-k127-7e8a9j5644a"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CapEventType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "abbreviation": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Error response with message",
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["VALIDATION_ERROR", "RESOURCE_NOT_FOUND", "INTERNAL_SERVER_ERROR", "ALLOCATION_ERROR"]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "title": "ErrorDetail",
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "timestamp": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CapEventProcessRequest": {
        "type": "object",
        "required": ["capEventEntityLineItems"],
        "properties": {
          "sponsorId": {
            "type": "string"
          },
          "capEventTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "templateId": {
            "type": "string",
            "format": "uuid"
          },
          "capEventEntityLineItems": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CapEventEntityLineItem" }
          }
        }
      },
      "CapEventEntityLineItem": {
        "type": "object",
        "required": ["entity", "dueDate", "capEventLineItems"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "entity": {
            "$ref": "#/components/schemas/Entity"
          },
          "noticeDate": {
            "type": "string",
            "format": "date"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "capEventLineItems": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CapEventLineItem" }
          }
        }
      },
      "CapEventLineItem": {
        "type": "object",
        "required": ["account", "investment", "allocationBasis", "amount"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "investment": {
            "$ref": "#/components/schemas/Investment"
          },
          "allocationBasis": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "Investment": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "title": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "Account": {
        "type": "object",
        "required": ["accountNo"],
        "properties": {
          "accountNo": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "insideCmnt": {
            "type": "string"
          }
        }
      },
      "Entity": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CapEventLineItemResponse": {
        "type": "object",
        "properties": {
          "entity": {
            "$ref": "#/components/schemas/Entity"
          },
          "plInvestorEntries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/InvestorEntry" }
          }
        }
      },
      "InvestorEntry": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "investment": {
            "$ref": "#/components/schemas/Investment"
          },
          "optOut": {
            "type": "boolean"
          },
          "readOnly": {
            "type": "boolean"
          },
          "rounded": {
            "type": "boolean"
          },
          "investor": {
            "type": "string"
          },
          "classID": {
            "type": "string"
          },
          "additionalInvestorType": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "commitment": {
            "type": "number"
          },
          "investedCapital": {
            "type": "number"
          },
          "unfunded": {
            "type": "number"
          },
          "managementFee": {
            "type": "number"
          },
          "managementFeePercentage": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          },
          "originalAmount": {
            "type": "number"
          },
          "allocatedAmount": {
            "type": "number"
          },
          "allocatedAmountNotRounded": {
            "type": "number"
          },
          "isTransferEntry": {
            "type": "boolean"
          },
          "trType": {
            "type": "integer"
          },
          "hasZeroCtb": {
            "type": "boolean"
          },
          "investorToRound": {
            "type": "boolean"
          },
          "location": {
            "type": "string"
          },
          "dataPoints": {
            "type": "string"
          },
          "isAggregated": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
