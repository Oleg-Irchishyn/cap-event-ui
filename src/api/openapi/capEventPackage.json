{
  "openapi": "3.0.0",
  "info": {
    "title": "Cap Event Package API",
    "version": "v1",
    "description": "API for retrieving capital event types"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "v1 API base path"
    }
  ],
  "paths": {
    "/cap-events/types": {
      "get": {
        "summary": "Retrieve list of capital event types",
        "operationId": "getCapEventTypes",
        "responses": {
          "200": {
            "description": "List of capital event types",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CapEventType" }
                },
                "examples": {
                  "example": {
                    "value": [
                      {
                        "id": "657475ed-b745-41d3-a864-463847900129",
                        "abbreviation": "Call",
                        "name": "Capital Call"
                      },
                      {
                        "id": "657475ed-b745-41d3-a864-463847900123",
                        "abbreviation": "Distr",
                        "name": "Distribution"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "VALIDATION_ERROR",
                  "message": "Validation failed for argument",
                  "details": {
                    "field": "folderId",
                    "reason": "INVALID_VALUE",
                    "message": "size must be between 1 and 2147483647"
                  },
                  "timestamp": "2025-08-20T11:13:13.012739700Z",
                  "requestId": "9b173b09-785n-6458-k127-7e8a9j5644a"
                }
              }
            }
          },
          "404": {
            "description": "No event types found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "RESOURCE_NOT_FOUND",
                  "message": "Resource not found",
                  "details": "null",
                  "timestamp": "2025-08-20T11:13:13.012739700Z",
                  "requestId": "9b173b09-785n-6458-k127-7e8a9j5644a"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "reason": "INTERNAL_SERVER_ERROR",
                  "message": "Internal Server Error",
                  "details": "null",
                  "timestamp": "2025-08-20T11:13:13.012739700Z",
                  "requestId": "9b173b09-785n-6458-k127-7e8a9j5644a"
                }
              }
            }
          }
        }
      }
    },
    "/cap-events": {
      "post": {
        "summary": "Process capital event",
        "operationId": "process",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapEventProcessRequest"
              },
              "examples": {
                "example": {
                  "value": {
                    "sponsorId": "SPONSOR123",
                    "capEventTypeId": "657475ed-b745-41d3-a864-463847900129",
                    "templateId": "987654ed-b745-41d3-a864-463847900456",
                    "capEventEntityLineItems": [
                      {
                        "id": "111111ed-b745-41d3-a864-463847900001",
                        "entity": {
                          "id": "ENTITY001",
                          "name": "Sample Entity LP"
                        },
                        "noticeDate": "2024-12-01",
                        "dueDate": "2024-12-15",
                        "capEventLineItems": [
                          {
                            "id": "222222ed-b745-41d3-a864-463847900002",
                            "account": {
                              "accountNo": "ACC123456",
                              "category": "Capital Call",
